---
import TombolaCalculator from "@/components/TombolaCalculator.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Tombola calculator">
  <main class="tool-page">
    <section class="tool-intro">
      <h1>Tombola calculator</h1>
      <p>Split a Tombola prize pool fairly, using the traditional progressive prize order. Add the price of a <em>cartella</em> if you want the calculator to preserve the minimum prizes.</p>
    </section>

    <TombolaCalculator />

    <section class="tool-notes">
      <h2>How it works</h2>
      <ul>
        <li><strong>Tombola</strong> is the largest prize; the caller traditionally buys six cards.</li>
        <li><strong>Cinquina, Quaterna, Terna, Ambo</strong> are awarded for five, four, three, and two numbers in a row.</li>
        <li>Amounts are rounded to €0.20, so a prize can be shared between two winners in €0.10 increments.</li>
      </ul>
    </section>
  </main>
</Layout>
